<?xml version="1.0" encoding="utf-8"?>
<!--
    Thanh đo trực tiếp dùng chung cho 3 màn kiểm tra, gồm 5 ô:
      FPS | % CPU của app | Số lần giật | RAM (heap) | Ô riêng của từng màn (ms bind, ms tìm kiếm, số màn hình bị leak...)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/bg_metric_box"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView android:id="@+id/tvFps" style="@style/XPhone.MetricValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" />
        <TextView style="@style/XPhone.MetricLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FPS" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/bg_metric_box"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView android:id="@+id/tvCpu" style="@style/XPhone.MetricValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" />
        <TextView style="@style/XPhone.MetricLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CPU" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/bg_metric_box"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView android:id="@+id/tvJank" style="@style/XPhone.MetricValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0" />
        <TextView style="@style/XPhone.MetricLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lần giật" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/bg_metric_box"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView android:id="@+id/tvRam" style="@style/XPhone.MetricValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" />
        <TextView style="@style/XPhone.MetricLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Heap MB" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/bg_metric_box"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView android:id="@+id/tvExtraValue" style="@style/XPhone.MetricValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" />
        <TextView android:id="@+id/tvExtraLabel" style="@style/XPhone.MetricLabel" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
