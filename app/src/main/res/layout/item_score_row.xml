<?xml version="1.0" encoding="utf-8"?>
<!-- Một dòng điểm thành phần ở màn kết quả, hoặc một dòng thông tin ở màn Thông tin thiết bị -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/xp_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvRowDetail"
            style="@style/XPhone.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRowValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/xp_primary_dark"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
